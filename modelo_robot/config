# Configuracion teleop_twist_joy para Xbox One/360 por USB en Ubuntu 22.04
# ──────────────────────────────────────────────────────────────────
# Mapeo ejes Xbox USB (verificado con jstest /dev/input/js0):
#   Eje 0 = Stick izquierdo horizontal  (izq=-1, der=+1)
#   Eje 1 = Stick izquierdo vertical    (arr=-1, abajo=+1)  ← adelante/atras
#   Eje 2 = LT gatillo                  (reposo=+1, presionado=-1)
#   Eje 3 = Stick derecho horizontal
#   Eje 4 = Stick derecho vertical
#   Eje 5 = RT gatillo                  (reposo=+1, presionado=-1)
#
# Mapeo botones Xbox USB:
#   0=A  1=B  2=X  3=Y  4=LB  5=RB  6=Back  7=Start  8=Xbox  9=L3  10=R3
#
# CONTROLES:
#   Mover  → Stick izquierdo (mantener LB presionado)
#   Turbo  → Stick izquierdo (mantener RB presionado)
#   Sin LB → robot no se mueve (seguridad)
# ──────────────────────────────────────────────────────────────────

teleop_twist_joy_node:
  ros__parameters:
    axis_linear:
      x: 1                  # stick izq vertical → adelante/atras
    axis_angular:
      yaw: 0                # stick izq horizontal → giro
    scale_linear:
      x: 0.3                # m/s normal (ajustar segun tu robot)
    scale_linear_turbo:
      x: 0.5                # m/s con turbo
    scale_angular:
      yaw: 1.5              # rad/s
    enable_button: 4        # LB = habilitar movimiento
    enable_turbo_button: 5  # RB = habilitar turbo
    require_enable_button: true
