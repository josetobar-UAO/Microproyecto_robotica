<?xml version="1.0" encoding="utf-8"?>
<!-- URDF_Microproyecto_10 — adaptado para Gazebo Ignition Fortress -->
<!-- Cambios respecto al original:                                   -->
<!--   - Colisiones: STL → primitivas (box/cylinder) evita ODE crash -->
<!--   - Meshes: package://URDF_Microproyecto_10 → modelo_robot      -->
<!--   - axis joint_der: "0 0 -1" → "0 0 1" (igual que joint_izq)   -->
<!--   - Tags <gazebo>: materiales, friccion, plugins DiffDrive+JSP  -->
<!--   - Spawn z=0.08 recomendado en gazebo.launch.py                -->
<robot name="URDF_Microproyecto_9">

  <!-- ══ BASE LINK ══════════════════════════════════════════════ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0030372 0.00024164 0.02336" rpy="0 0 0"/>
      <mass value="0.47644"/>
      <inertia
        ixx="0.00052706"
        ixy="3.3897E-08"
        ixz="-4.5933E-06"
        iyy="0.0002435"
        iyz="3.127E-08"
        izz="0.00062029"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modelo_robot/meshes/base_link.STL"/>
      </geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <!-- Colision: caja aproximada al chasis -->
    <collision>
      <origin xyz="0.003 0.0002 0.023" rpy="0 0 0"/>
      <geometry><box size="0.12 0.085 0.05"/></geometry>
    </collision>
  </link>

  <!-- ══ RUEDA IZQUIERDA ════════════════════════════════════════ -->
  <link name="Rueda_izq">
    <inertial>
      <origin xyz="7.07458613047954E-05 3.53647017556601E-05 -0.000631498941864889" rpy="0 0 0"/>
      <mass value="0.0157184722885494"/>
      <inertia
        ixx="1.6900538447052E-06"
        ixy="2.14652112438877E-10"
        ixz="2.40582412374417E-10"
        iyy="1.69132187199093E-06"
        iyz="1.46085961024242E-09"
        izz="2.1652262699732E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modelo_robot/meshes/Rueda_izq.STL"/>
      </geometry>
      <material name=""><color rgba="0.298 0.298 0.298 1"/></material>
    </visual>
    <!-- Colision: cilindro radio=0.015m ancho=0.012m -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.012"/></geometry>
    </collision>
  </link>

  <joint name="joint_izq" type="continuous">
    <origin xyz="-0.033127 0.040636 -0.0020475" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="Rueda_izq"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ══ RUEDA DERECHA ══════════════════════════════════════════ -->
  <link name="Rueda_der">
    <inertial>
      <origin xyz="7.90235797321938E-05 3.30346308194743E-06 0.000631498941864886" rpy="0 0 0"/>
      <mass value="0.0157184722885494"/>
      <inertia
        ixx="1.69053286024459E-06"
        ixy="-6.51171572346073E-10"
        ixz="-9.17714123617353E-10"
        iyy="1.69084285645155E-06"
        iyz="1.1618052699549E-09"
        izz="2.1652262699732E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modelo_robot/meshes/Rueda_der.STL"/>
      </geometry>
      <material name=""><color rgba="0.298 0.298 0.298 1"/></material>
    </visual>
    <!-- Colision: cilindro radio=0.015m ancho=0.012m -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.012"/></geometry>
    </collision>
  </link>

  <!-- axis="0 0 1" igual que joint_izq — DiffDrive requiere mismo eje -->
  <joint name="joint_der" type="continuous">
    <origin xyz="-0.034252 -0.040164 -0.0010202" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="Rueda_der"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ══ CAM LINK ═══════════════════════════════════════════════ -->
  <link name="Cam_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- masa 0 original conservada — link puramente visual -->
      <mass value="0.001"/>
      <inertia ixx="1E-09" ixy="0" ixz="0" iyy="1E-09" iyz="0" izz="1E-09"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modelo_robot/meshes/Cam_link.STL"/>
      </geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.008 -0.007 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.015"/></geometry>
    </collision>
  </link>

  <joint name="joint_cam" type="fixed">
    <origin xyz="0.04341 0.00043637 0.0255" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="Cam_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ══ GAZEBO: materiales ══════════════════════════════════════ -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="Rueda_izq">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="Rueda_der">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="Cam_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ══ GAZEBO: friccion ruedas ════════════════════════════════ -->
  <gazebo reference="Rueda_izq">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="Rueda_der">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <!-- ══ PLUGIN: DiffDrive ══════════════════════════════════════ -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>joint_izq</left_joint>
      <right_joint>joint_der</right_joint>
      <wheel_separation>0.0808</wheel_separation>
      <wheel_radius>0.015</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <robot_base_frame>base_link</robot_base_frame>
      <min_velocity>-10.0</min_velocity>
      <max_velocity>10.0</max_velocity>
      <min_acceleration>-5.0</min_acceleration>
      <max_acceleration>5.0</max_acceleration>
    </plugin>
  </gazebo>

  <!-- ══ PLUGIN: JointStatePublisher ═══════════════════════════ -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
