<?xml version="1.0" encoding="utf-8"?>
<!-- URDF v6 - ejes invertidos respecto a v5, giro con min_velocity -->
<robot name="URDF_Microproyecto_9">

  <link name="base_link">
    <inertial>
      <origin xyz="0.00303718710195896 0.000241641070373277 0.0233597079676121" rpy="0 0 0"/>
      <mass value="0.476441238351147"/>
      <inertia
        ixx="0.000527064543211955"
        ixy="3.38969605841737E-08"
        ixz="-4.59325964242475E-06"
        iyy="0.000243496413695201"
        iyz="3.12703631411997E-08"
        izz="0.000620291787944453"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modelo_robot/meshes/base_link.STL"/>
      </geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.003 0.0002 0.023" rpy="0 0 0"/>
      <geometry><box size="0.12 0.085 0.05"/></geometry>
    </collision>
  </link>

  <link name="Rueda_izq">
    <inertial>
      <origin xyz="7.07458613047919E-05 3.53647017556566E-05 -0.00063149894186489" rpy="0 0 0"/>
      <mass value="0.0157184722885494"/>
      <inertia
        ixx="1.6900538447052E-06"
        ixy="2.14652112438886E-10"
        ixz="2.40582412374417E-10"
        iyy="1.69132187199093E-06"
        iyz="1.46085961024242E-09"
        izz="2.1652262699732E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modelo_robot/meshes/Rueda_izq.STL"/>
      </geometry>
      <material name=""><color rgba="0.298 0.298 0.298 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.012"/></geometry>
    </collision>
  </link>

  <!-- axis invertido: "0 0 -1" → en world frame con Rx90 = [0,+1,0] -->
  <!-- v_contacto = [0,1,0] x [0,0,-0.015] = [-0.015,0,0] con vel+   -->
  <!-- DiffDrive manda vel- para retroceder = contacto va en +X = ADELANTE -->
  <!-- Equivalente a invertir el sentido: i=adelante, ,=atras          -->
  <joint name="joint_izq" type="continuous">
    <origin xyz="-0.033127 0.040636 -0.0020475" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="Rueda_izq"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="Rueda_der">
    <inertial>
      <origin xyz="7.90235797321903E-05 3.30346308194743E-06 0.000631498941864886" rpy="0 0 0"/>
      <mass value="0.0157184722885494"/>
      <inertia
        ixx="1.69053286024459E-06"
        ixy="-6.5117157234606E-10"
        ixz="-9.17714123617357E-10"
        iyy="1.69084285645155E-06"
        iyz="1.1618052699549E-09"
        izz="2.1652262699732E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modelo_robot/meshes/Rueda_der.STL"/>
      </geometry>
      <material name=""><color rgba="0.298 0.298 0.298 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.012"/></geometry>
    </collision>
  </link>

  <joint name="joint_der" type="continuous">
    <origin xyz="-0.034252 -0.040164 -0.0010202" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="Rueda_der"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="Cam_link">
    <inertial>
      <origin xyz="-0.00761657670891421 -0.00747059469769067 1.39730355321818E-05" rpy="0 0 0"/>
      <mass value="0.00241389293196676"/>
      <inertia
        ixx="2.20027071419733E-07"
        ixy="-7.73419619969269E-12"
        ixz="-6.16071045877555E-11"
        iyy="7.82512589004426E-08"
        iyz="6.02574141068783E-10"
        izz="1.45696619419382E-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modelo_robot/meshes/Cam_link.STL"/>
      </geometry>
      <material name=""><color rgba="0.792 0.820 0.933 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.008 -0.007 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.015"/></geometry>
    </collision>
  </link>

  <joint name="joint_cam" type="fixed">
    <origin xyz="0.04341 0.00043637 0.0255" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="Cam_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="Rueda_izq">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="Rueda_der">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="Cam_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="Rueda_izq">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="Rueda_der">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo>
    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>joint_izq</left_joint>
      <right_joint>joint_der</right_joint>
      <wheel_separation>0.0808</wheel_separation>
      <wheel_radius>0.015</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <robot_base_frame>base_link</robot_base_frame>
      <!-- min_velocity evita zona muerta en giro puro (j y l) -->
      <min_velocity>-10.0</min_velocity>
      <max_velocity>10.0</max_velocity>
      <min_acceleration>-5.0</min_acceleration>
      <max_acceleration>5.0</max_acceleration>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
